// Prisma schema for Dutchie Security Awareness Month 2026
//
// SQLite, not Postgres. Postgres ran as a separately-installed system
// service on this VAPE pod's own disk with no persistent volume - a pod
// crash/restart wiped it out entirely once already (see db-backups/ history).
// SQLite is a single file with no service to lose; combined with the
// periodic backup practice in scripts/backup-db.ts, this survives a pod
// wipe with a simple restore instead of a full reinstall + migrate + reseed.
//
// SQLite has no native enum or scalar-array type support in Prisma, so the
// four enums and the one `String[]` field below are modeled as plain
// String columns (JSON-encoded where the value is itself a list). Valid
// values are documented in comments and enforced in application code
// (src/lib/tiers.ts, src/lib/flare.ts) exactly the same way the equivalent
// Flux/SQLite port already does.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id             String    @id @default(cuid())
  /// The stable identity key used everywhere in the app (profile URLs, photo
  /// routes, deterministic flavor hashing, leaderboard grouping). Despite
  /// the field name (kept to avoid a large mechanical rename across the
  /// codebase), this no longer holds a real email address as of the
  /// name+PIN auth migration - it holds a lowercase, hyphenated slug
  /// derived from the employee's full name (see slugifyName in
  /// src/lib/auth.ts), e.g. "nick-duda". Collisions on a shared name get a
  /// numbered suffix ("nick-duda-2").
  email          String    @unique
  displayName    String
  /// bcrypt hash of the employee's 4-digit PIN. Null means a legacy row
  /// migrated from the old email-cookie identity model that hasn't been
  /// "claimed" (had a PIN set) yet - see claimOrRegisterAction in
  /// src/lib/actions/identify.ts.
  pinHash        String?
  rogueOverride  Boolean   @default(false)
  /// Grants full /admin panel access with no passphrase needed - see
  /// isAdminSession() in src/lib/session.ts. "nick-duda" is a permanent
  /// admin, hardcoded and un-removable in toggleAdminAction (see admin.ts).
  isAdmin        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  photo          Bytes?
  photoMimeType  String?
  photoUpdatedAt DateTime?

  submissions Submission[]
  flare       BadgeFlare?
}

model Challenge {
  id  String @id @default(cuid())
  slug String @unique
  title String
  description String
  /// One of: EXACT | CASE_INSENSITIVE | MULTIPLE_CHOICE | FREE_TEXT_REVIEW
  answerType    String
  correctAnswer String? // null for FREE_TEXT_REVIEW
  /// JSON-encoded string[] for MULTIPLE_CHOICE (SQLite has no native Json type in this Prisma version)
  choices       String?
  xpValue       Int
  /// One of: XP | UNLOCK
  rewardMode    String @default("XP")

  // Optional image shown alongside the question itself — e.g. a phishing
  // screenshot to inspect before picking a multiple-choice answer. Usable
  // on any challenge, regardless of rewardMode.
  questionImage         Bytes?
  questionImageMimeType String?

  // Unlock-mode reveal content (only meaningful when rewardMode = UNLOCK).
  // Any subset may be set — whatever's populated renders on a correct answer.
  unlockAudio         Bytes?
  unlockAudioMimeType String?
  unlockText          String?
  unlockLinkUrl       String?
  unlockLinkLabel     String?
  unlockImage         Bytes?
  unlockImageMimeType String?
  unlockVideo         Bytes?
  unlockVideoMimeType String?

  // Advertised badge-flare reward — mirrors the same fields on BadgeFlare (see flare.ts for the
  // validated value sets). Granted by hand via /admin/flare once someone actually completes the
  // challenge; these just describe what's on offer.
  rewardBackgroundEffect String?
  rewardBorderStyle      String?
  rewardIcon             String?
  rewardRibbonText       String?
  rewardNameSuffix       String?
  // These two aren't a specific color value to unlock — they grant the
  // *capability* to use the free-color picker for that field at all.
  // Once unlocked, the employee can set literally any resolvable color of
  // their own choosing (see selfFlare.ts), not a pre-set option.
  rewardOutlineColorPicker    Boolean @default(false)
  rewardBackgroundColorPicker Boolean @default(false)
  rewardPrize            String? // freeform other prize, e.g. "Company hoodie", "Extra PTO day"
  /// One of: UNCLASSIFIED | SECRET | TOP_SECRET | ROGUE
  minClearance  String @default("UNCLASSIFIED")
  isActive      Boolean    @default(true)
  opensAt       DateTime?
  closesAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  submissions Submission[]
}

model Submission {
  id           String   @id @default(cuid())
  employeeId   String
  challengeId  String
  answerRaw    String
  /// One of: CORRECT | INCORRECT | PENDING_REVIEW
  status       String
  xpAwarded    Int      @default(0)
  submittedAt  DateTime @default(now())
  reviewedBy   String?
  reviewedAt   DateTime?

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, challengeId])
  @@index([employeeId])
  @@index([challengeId])
}

model BadgeFlare {
  employeeId       String    @id
  /// JSON-encoded string[] (SQLite has no native scalar-array type)
  achievements     String    @default("[]")
  outlineColor     String?
  backgroundColor  String?
  backgroundEffect String?
  codenameOverride String?
  motto            String?
  iconOverride     String?
  borderStyle      String?
  ribbonText       String?
  nameSuffix       String?
  /// Freeform text admins (game masters) can stash on the back of an
  /// agent's badge - not shown anywhere else, purely a hiding spot for a
  /// clue/code word to be used in a later challenge. No validation - any
  /// text is fine.
  secretBackText   String?
  expiresAt        DateTime?
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model AdminAudit {
  id        String   @id @default(cuid())
  action    String
  detail    String
  createdAt DateTime @default(now())
}
