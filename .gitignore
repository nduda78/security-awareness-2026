# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# DB backups (Oct 2026+): committing these to git grew .git to 800+MB and
# started tripping GitHub's 100MB single-file limit as challenge media
# assets got bigger. S3 (see scripts/backup-db.sh) is now the sole backup
# destination going forward - these still get written locally, just never
# committed. Already-committed history from before this change is left
# alone (would need a force-push to actually shrink .git, which this repo
# doesn't allow).
db-backups/*.sql
db-backups/*.sql.gz
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite live database + WAL/SHM sidecars — never commit the binary DB.
# Durable backups live in db-backups/*.sql instead (see scripts/backup-db.sh).
prisma/data/
data/

# One-off Postgres->SQLite migration exports contain raw employee data —
# never commit; scripts/export-postgres-data.ts regenerates this if needed.
scripts/postgres-export.json
